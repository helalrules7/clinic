<!DOCTYPE html>
<html lang="<?= $lang ?>" dir="<?= $lang === 'ar' ? 'rtl' : 'ltr' ?>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><?= $title ?? 'Docs' ?></title>
    
    <!-- Cairo Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap" rel="stylesheet">
    
    <!-- Icons -->
    <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet">

    <link rel="stylesheet" href="/docs/opth/public/assets/css/style.css?v=2">
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body class="loading">
    <div id="app">
        <!-- Topbar -->
        <header class="topbar">
            <div class="logo">
                <button id="sidebar-toggle" class="icon-btn">
                    <i class="ri-menu-2-line"></i>
                </button>
                <i class="ri-book-open-line"></i> <span>H<span class="highlight">CLINIC</span> | DOCS<span class="highlight">HUB</span></span>
            </div>
            <div class="actions">
                <button class="search-trigger" id="open-search">
                    <i class="ri-search-line"></i>
                    <span class="search-text"><?= $lang === 'ar' ? 'بحث (Ctrl+K)' : 'Search (Ctrl+K)' ?></span>
                </button>
                <button id="theme-toggle" class="icon-btn">
                    <i class="ri-moon-line"></i>
                </button>
                <?php
                    $switchLang = $lang === 'ar' ? 'en' : 'ar';
                    $switchUrl = "?lang=$switchLang";
                    if (isset($_GET['id'])) {
                        $switchUrl .= "&id=" . $_GET['id'];
                    }
                ?>
                <a href="<?= $switchUrl ?>" class="lang-switch">
                    <?= $lang === 'ar' ? 'English' : 'العربية' ?>
                </a>
            </div>
        </header>
        
        <div class="main-container">
            <!-- Sidebar -->
            <aside class="sidebar">
                <nav>
                    <ul class="root-items">
                        <li>
                            <?php 
                                $homeUrl = (isset($isDashboard) && $isDashboard) 
                                    ? '/docs/opth/dashboard?id=1' 
                                    : '/docs/opth/?id=1';
                            ?>
                            <a href="<?= $homeUrl ?>&lang=<?= $lang ?>" class="<?= (!isset($_GET['id']) || $_GET['id'] == 1) ? 'active' : '' ?>">
                                <i class="ri-home-4-line"></i> <?= $lang === 'ar' ? 'البداية' : 'Getting Started' ?>
                            </a>
                        </li>
                        
                        <?php foreach ($menuTree as $root): ?>
                            <?php if ($root['id'] == 1) continue; // Skip Getting Started as it's hardcoded ?>
                            <li>
                                <?php 
                                    $linkId = $root['id'];
                                    // If we are in dashboard, standard links should go to dashboard editing
                                    // If we are in frontend, standard links should go to frontend view
                                    if (isset($isDashboard) && $isDashboard) {
                                        $baseUrl = '/docs/opth/dashboard?id=';
                                    } else {
                                        $baseUrl = '/docs/opth/?id=';
                                    }
                                    
                                    $isActive = (isset($_GET['id']) && $_GET['id'] == $linkId) ? 'active' : '';
                                ?>
                                <div class="root-item-wrapper">
                                    <a href="<?= $baseUrl . $linkId ?>&lang=<?= $lang ?>" 
                                       class="root-title <?= $isActive ?>">
                                        <i class="<?= htmlspecialchars($root['icon'] ?? 'ri-folder-line') ?>"></i> <?= htmlspecialchars($root['title'] ?? 'Untitled') ?>
                                    </a>
                                    <?php if (!empty($root['children'])): ?>
                                        <button class="expand-toggle" aria-label="Toggle submenu">
                                            <i class="ri-arrow-down-s-line"></i>
                                        </button>
                                    <?php endif; ?>
                                </div>
                                <?php if (!empty($root['children'])): ?>
                                    <ul class="sub-items expanded">
                                        <?php foreach ($root['children'] as $child): ?>
                                            <?php 
                                                $childLink = $baseUrl . $child['id'];
                                                $isChildActive = (isset($_GET['id']) && $_GET['id'] == $child['id']) ? 'active' : '';
                                                $hasActiveChild = false;
                                                if (!empty($child['children'])) {
                                                    foreach ($child['children'] as $grandchild) {
                                                        if (isset($_GET['id']) && $_GET['id'] == $grandchild['id']) {
                                                            $hasActiveChild = true;
                                                            break;
                                                        }
                                                    }
                                                }
                                                // Always expanded by default
                                                $childExpanded = 'expanded';
                                            ?>
                                            <li class="<?= $childExpanded ?>">
                                                <div class="sub-item-wrapper">
                                                    <a href="<?= $childLink ?>&lang=<?= $lang ?>" 
                                                       class="sub-item-title <?= $isChildActive ?>">
                                                        <?php if (!empty($child['icon'])): ?>
                                                            <i class="<?= htmlspecialchars($child['icon']) ?>"></i>
                                                        <?php endif; ?>
                                                        <?= htmlspecialchars($child['title'] ?? 'Untitled') ?>
                                                    </a>
                                                    <?php if (!empty($child['children'])): ?>
                                                        <button class="expand-toggle sub-expand-toggle" aria-label="Toggle submenu">
                                                            <i class="ri-arrow-down-s-line"></i>
                                                        </button>
                                                    <?php endif; ?>
                                                </div>
                                                <?php if (!empty($child['children'])): ?>
                                                    <ul class="sub-items nested-sub-items expanded">
                                                        <?php foreach ($child['children'] as $grandchild): ?>
                                                            <?php 
                                                                $grandchildLink = $baseUrl . $grandchild['id'];
                                                                $isGrandchildActive = (isset($_GET['id']) && $_GET['id'] == $grandchild['id']) ? 'active' : '';
                                                            ?>
                                                            <li>
                                                                <a href="<?= $grandchildLink ?>&lang=<?= $lang ?>" 
                                                                   class="<?= $isGrandchildActive ?>">
                                                                    <?php if (!empty($grandchild['icon'])): ?>
                                                                        <i class="<?= htmlspecialchars($grandchild['icon']) ?>"></i>
                                                                    <?php endif; ?>
                                                                    <?= htmlspecialchars($grandchild['title'] ?? 'Untitled') ?>
                                                                </a>
                                                            </li>
                                                        <?php endforeach; ?>
                                                    </ul>
                                                <?php endif; ?>
                                            </li>
                                        <?php endforeach; ?>
                                    </ul>
                                <?php endif; ?>
                            </li>
                        <?php endforeach; ?>
                    </ul>
                </nav>
            </aside>
            
            <!-- Content -->
            <main class="content-area">
                <!-- Back to Top Button -->
                <button id="back-to-top" class="back-to-top" aria-label="Back to top">
                    <i class="ri-arrow-up-line"></i>
                </button>
                <?= $content ?>
            </main>
        </div>
    </div>
    
    <!-- Search Modal -->
    <div id="search-modal" class="search-modal-backdrop" style="display: none;">
        <div class="search-modal-content">
            <header class="search-header">
                <i class="ri-search-line"></i>
                <input type="text" id="global-search-input" placeholder="<?= $lang === 'ar' ? 'ابحث في التوثيق...' : 'Search documentation...' ?>" autocomplete="off">
                <button id="close-search">
                    <i class="ri-close-line"></i>
                </button>
            </header>
            <div class="search-results" id="search-results-container">
                <!-- Results will appear here -->
                <div class="empty-state">
                    <?= $lang === 'ar' ? 'ابدأ الكتابة للبحث...' : 'Start typing to search...' ?>
                </div>
            </div>
        </div>
    </div>

    <script src="/docs/opth/public/assets/js/app.js?v=2"></script>
</body>
</html>
